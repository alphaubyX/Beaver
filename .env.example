# Copy this file to ".env" and fill it in. ".env" is never committed to git.

# Admin login created the first time Beaver starts (when the database is empty).
BEAVER_ADMIN_USERNAME=admin
BEAVER_ADMIN_PASSWORD=change-me-please
BEAVER_ADMIN_NAME=Admin

# Set to true for one start to reset the admin password above if you forget it, then set it back to false.
BEAVER_ADMIN_RESET_PASSWORD=false

# Hosted database (optional; required on Vercel). Create one free at https://turso.tech
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=...

# Server
PORT=3000
# BEAVER_DB=./data/beaver.db
# TRUST_PROXY=1
